{
  "name": "ethos-telegram-bot",
  "version": "1.1.0",
  "description": "Production-ready TypeScript Telegram bot for Ethos Network profile activity notifications.",
  "main": "dist/bot.js",
  "scripts": {
    "auth": "ts-node src/auth/server.ts",
    "build": "npm run build:server && npm run build:auth",
    "build:auth": "node -e \"require('esbuild').buildSync({ entryPoints: ['src/auth/client.ts'], bundle: true, outfile: 'public/auth.js', format: 'iife', platform: 'browser' });\"",
    "build:server": "tsc -p tsconfig.json",
    "dev": "tsx watch src/bot.ts",
    "start": "node dist/bot.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "telegram",
    "bot",
    "ethos",
    "typescript",
    "postgresql"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@privy-io/js-sdk-core": "^0.60.5",
    "axios": "^1.8.4",
    "body-parser": "^1.20.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "node-cron": "^4.2.1",
    "pg": "^8.13.3",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "esbuild": "^0.25.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
